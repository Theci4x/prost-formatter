# Copie ce fichier en .env.local (jamais commité) et renseigne les valeurs
# depuis Supabase > Project Settings > API (projet "Klarr").

NEXT_PUBLIC_SUPABASE_URL=https://qjyykthkxaqiomhlzaeq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Adresse publique de l'app (sert à construire l'URL de retour OAuth
# Google/Facebook). En https:// car "Facebook Login for Business" (FB.login)
# refuse de s'exécuter sur une page http:// — `npm run dev` lance le serveur
# en HTTPS local (certificat auto-signé) via --experimental-https.
NEXT_PUBLIC_SITE_URL=https://localhost:3000

# Google Cloud Console > APIs & Services > Identifiants > ID client OAuth.
# Redirect URI à déclarer côté Google : ${NEXT_PUBLIC_SITE_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# console.anthropic.com > API Keys — utilisée pour l'analyse SEO par Claude
# et pour la page "Visibilité IA".
ANTHROPIC_API_KEY=

# Assistants supplémentaires pour la page "Visibilité IA". Chacun est
# facultatif : sans sa clé il est simplement ignoré, et il s'active sans
# changement de code dès que la clé est renseignée. Les variables *_MODEL
# permettent d'ajuster le nom du modèle si le fournisseur le renomme, sans
# redéployer.
# platform.openai.com > API keys
OPENAI_API_KEY=
OPENAI_MODEL=
# aistudio.google.com > Get API key
GEMINI_API_KEY=
GEMINI_MODEL=
# perplexity.ai > Settings > API
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=

# Google Cloud Console > APIs & Services > activer "Places API (New)" +
# facturation. Clé API simple (pas d'OAuth) — utilisée pour l'audit
# automatique de /test-presence-google.
GOOGLE_PLACES_API_KEY=

# yelp.com/developers — clé API self-service, gratuite (quota limité).
YELP_API_KEY=

# tripadvisor.com/developers — clé API self-service.
TRIPADVISOR_API_KEY=

# developers.facebook.com > Créer une App > "Facebook Login for Business" >
# Paramètres. Redirect URI à déclarer : ${NEXT_PUBLIC_SITE_URL}/api/facebook/callback
# Fonctionne immédiatement pour les comptes ajoutés comme "testeurs" sur
# l'App (mode développement) ; App Review Meta nécessaire pour un usage
# public par n'importe quel restaurateur.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# developers.facebook.com > l'App > "Facebook Login for Business" >
# Configurations > (créer une configuration avec token "utilisateur" et les
# permissions pages_show_list / pages_read_engagement / instagram_basic).
FACEBOOK_LOGIN_CONFIG_ID=

# Meme valeurs que FACEBOOK_APP_ID / FACEBOOK_LOGIN_CONFIG_ID ci-dessus,
# mais exposees au navigateur (prefixe NEXT_PUBLIC_) : le SDK JavaScript
# Facebook (FB.login) tourne cote client et en a besoin pour initier la
# connexion "Facebook Login for Business" (le flux par simple redirection
# ne fonctionne pas pour ce produit).
NEXT_PUBLIC_FACEBOOK_APP_ID=
NEXT_PUBLIC_FACEBOOK_LOGIN_CONFIG_ID=

# developers.tiktok.com > Manage apps > créer une app > ajouter le produit
# "Login Kit". Redirect URI à déclarer : ${NEXT_PUBLIC_SITE_URL}/api/tiktok/callback
# Scopes à activer : user.info.basic, user.info.stats, video.list.
# Fonctionne immédiatement en mode "Sandbox"/développement avec ton propre
# compte TikTok ajouté comme testeur ; une revue TikTok est nécessaire pour
# un usage public par n'importe quel restaurateur.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Secret partagé avec la tâche planifiée Vercel qui relève chaque nuit la
# note et le nombre d'avis de chaque établissement (vercel.json > crons).
# Vercel envoie « Authorization: Bearer <valeur> » ; sans cette variable la
# route refuse de s'exécuter plutôt que de s'ouvrir à tous. À définir aussi
# dans Vercel > Settings > Environment Variables. Une longue chaîne
# aléatoire fait l'affaire.
CRON_SECRET=

# Adresses e-mail autorisées à ouvrir /admin, séparées par des virgules.
# Vide = personne : si la variable est oubliée lors d'un déploiement,
# l'espace se ferme au lieu de s'ouvrir à tous.
ADMIN_EMAILS=

# Supabase > Project Settings > API > "service_role" (clé secrète, jamais
# exposée côté client). Utilisée uniquement par le webhook Stripe pour
# écrire le statut d'abonnement en base (RLS n'autorise pas les
# utilisateurs à modifier cette table).
SUPABASE_SERVICE_ROLE_KEY=

# dashboard.stripe.com > Developers > API keys (reste en mode Test tant que
# le compte n'est pas activé pour de vrais paiements).
STRIPE_SECRET_KEY=

# dashboard.stripe.com > Connect > Settings > "Platform settings" >
# Integration : identifiant de l'application (commence par "ca_"). C'est le
# compte Stripe d'EDIREF qui joue ici le rôle de plateforme — il ne reçoit
# jamais l'argent des clients des restaurateurs, il sert seulement à
# identifier Klarr comme l'application à laquelle ils relient leur compte.
#
# Dans la même page, déclarer l'URL de redirection :
#   ${NEXT_PUBLIC_SITE_URL}/api/stripe/connect/callback
# Stripe refuse toute redirection non déclarée à l'avance.
#
# Comptes "Standard" : le restaurateur garde son tableau de bord, ses
# virements et ses litiges. Klarr n'est pas intermédiaire de paiement.
STRIPE_CONNECT_CLIENT_ID=

# Pour que l'acompte d'un client soit enregistré même s'il ferme l'onglet
# juste après avoir payé, activer dans le même endpoint les événements des
# comptes connectés : dashboard.stripe.com > Developers > Webhooks >
# l'endpoint > "Listen to events on Connected accounts".
#
# dashboard.stripe.com > Developers > Webhooks > créer un endpoint pointant
# vers ${NEXT_PUBLIC_SITE_URL}/api/stripe/webhook (événements à écouter :
# checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted). La clé de signature est affichée après
# création de l'endpoint.
STRIPE_WEBHOOK_SECRET=

# dashboard.stripe.com > Product catalog > créer le produit "Abonnement
# Klarr" avec un prix récurrent mensuel. Copier l'ID du prix (commence par
# "price_"). Les moyens de paiement (carte, SEPA...) sont choisis
# automatiquement par "Managed Payments" (Settings > Managed Payments) —
# pas besoin de les préciser dans le code.
STRIPE_PRICE_ID=
