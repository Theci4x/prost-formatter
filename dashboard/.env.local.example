# Copie ce fichier en .env.local (jamais commité) et renseigne les valeurs
# depuis Supabase > Project Settings > API (projet "Klarr").

NEXT_PUBLIC_SUPABASE_URL=https://qjyykthkxaqiomhlzaeq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Adresse publique de l'app (sert à construire l'URL de retour OAuth Google).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Cloud Console > APIs & Services > Identifiants > ID client OAuth.
# Redirect URI à déclarer côté Google : ${NEXT_PUBLIC_SITE_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# console.anthropic.com > API Keys — utilisée pour l'analyse SEO par Claude.
ANTHROPIC_API_KEY=

# Google Cloud Console > APIs & Services > activer "Places API (New)" +
# facturation. Clé API simple (pas d'OAuth) — utilisée pour l'audit
# automatique de /test-presence-google.
GOOGLE_PLACES_API_KEY=
